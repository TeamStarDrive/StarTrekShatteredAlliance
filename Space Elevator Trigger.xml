<ExplorationEvent>
  <Name>Space Elevator Trigger</Name>
  <PotentialOutcomes>

    <Outcome>
      <Chance>5</Chance>
      <TitleText>The Heavy Fall</TitleText>
      <DescriptionText>The space elevator is very old and may crumble at any moment. The shuttles disturb it and the elevator begins to tilt and fall. The huge structure rains down on the planet. Planet scans changed: -2 Fertility, some tiles lost.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
      <ChangeBaseFertility>-2</ChangeBaseFertility>
      <NumTilesToMakeUnhabitable>6</NumTilesToMakeUnhabitable>
      <Image>Encounters/1.png</Image>
      <ConfirmText>There she goes</ConfirmText>
    </Outcome>

     <Outcome>
      <Chance>10</Chance>
      <TitleText>Costly Encounter</TitleText>
      <DescriptionText>The elevator is beyond repair, so your troops plan a controlled demolition. As they place the charges a horde of burrowing predators comes out. Planet scans changed: -1 Fertility, some tiles lost.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
      <ChangeBaseFertility>-1</ChangeBaseFertility>
      <NumTilesToMakeUnhabitable>2</NumTilesToMakeUnhabitable>
      <TroopsToSpawn>
        <string>Antlion</string>
        <string>Antlion</string>
          <string>Antlion</string>
      </TroopsToSpawn>      
      <Image>Encounters/2.png</Image>
      <ConfirmText>Light them up</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>5</Chance>
      <TitleText>Unwanted Attention</TitleText>
      <DescriptionText>The elevator is working and ready for use, but it has been noticed by more than your scanners. An automated fleet warps in and bombs it to pieces. Planet scans changed: -1 Fertility and -0.6 Max Fertility, some tiles lost.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
      <NumTilesToMakeUnhabitable>4</NumTilesToMakeUnhabitable>
      <ChangeBaseFertility>-1</ChangeBaseFertility>
      <ChangeBaseMaxFertility>-0.6</ChangeBaseMaxFertility>
      <RemnantShipsToSpawn>
        <string>Heavy Drone</string>
        <string>Heavy Drone</string>
        <string>Heavy Drone</string>
        <string>Xeno Fighter</string>
        <string>Xeno Fighter</string>
        <string>Light Ancient Bomber</string>
        <string>Light Ancient Bomber</string>
        <string>Ancient Frigate</string>
       </RemnantShipsToSpawn>
       <Image>Encounters/remn1.png</Image>
       <ConfirmText>They will pay for that</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>30</Chance>
      <TitleText>Scrap</TitleText>
      <DescriptionText>The elevator is very old and beyond repair. Your troops take it down in a controlled demolition and keep the scrap.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Scrapyard</ReplaceWith>
      <Image>Encounters/4.png</Image>
      <ConfirmText>Nice job</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>25</Chance>
      <TitleText>Pirate Base</TitleText>
      <DescriptionText>The space elevator is working. It is also in use by Nausicaan raiders.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
       <ReplaceWith>Space Elevator</ReplaceWith>
      <PirateShipsToSpawn>
        <string>Draug Asteroid Base</string>
          <string>Draug</string>
          <string>Draug-Fighter</string>          
          <string>Draug-Fighter</string>          
          <string>Draug-Fighter</string>          
          <string>Draug-Fighter</string>          
          <string>Draug-Fighter</string>          
      </PirateShipsToSpawn>
      <Image>Encounters/pirates1.png</Image>
      <ConfirmText>Get rid of the pirates</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>35</Chance>
      <TitleText>The Elevator</TitleText>
      <DescriptionText>The space elevator is fully operational and ready for use.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
       <ReplaceWith>Space Elevator</ReplaceWith>
      <Image>Encounters/6.png</Image>
      <ConfirmText>Let's use it</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>22</Chance>
      <TitleText>What a Marvel</TitleText>
      <DescriptionText>The space elevator is fully operational. There is also a working shipyard orbiting the planet.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
       <ReplaceWith>Space Elevator</ReplaceWith>
      <FriendlyShipsToSpawn>
          <string>Shipyard</string>
          <string>Shipyard</string>
      </FriendlyShipsToSpawn>
      <Image>Encounters/5.png</Image>
      <ConfirmText>Command will be pleased</ConfirmText>
    </Outcome>
    
  </PotentialOutcomes>
 </ExplorationEvent>