    <Outcome>
      <Chance>50</Chance>
      <TitleText>Not Guilty</TitleText>
      <DescriptionText>Q finds us not guilty and then, with a flourish, locks the door and sends in a squad of Borg drones to prove it.</DescriptionText>
      <MoneyGranted>200</MoneyGranted>
      <ScienceBonus>0.02</ScienceBonus>
      <TroopsToSpawn>
        <string>FreeBorg</string>
        <string>FreeBorg</string>
      </TroopsToSpawn>
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Merely a Mortal</ReplaceWith>
      <Image>Encounters/st_32_Qs_Trial.png</Image>
      <ConfirmText>Resist</ConfirmText>
    </Outcome>
  </PotentialOutcomes>
