<?xml version="1.0" encoding="utf-8"?>
<ExplorationEvent>
  <Name>Qs Trial</Name>
  <PotentialOutcomes>
    <Outcome>
      <Chance>50</Chance>
      <TitleText>Guilty as Charged</TitleText>
