      <MoneyGranted>300</MoneyGranted>
      <ScienceBonus>0.04</ScienceBonus>
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Merely a Mortal</ReplaceWith>
      <Image>Encounters/st_32_Qs_Trial.png</Image>
