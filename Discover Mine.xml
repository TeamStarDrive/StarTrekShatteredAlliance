<ExplorationEvent>
  <Name>Discover Ancient Mine</Name>
  <PotentialOutcomes>
    <Outcome>
      <Chance>20</Chance>
      <TitleText>Infested</TitleText>
      <DescriptionText>The old dilithium works are in excellent condition, but a nest of burrowing predators has made it their den. The away team is surrounded almost at once.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Nano Mine</ReplaceWith>
      <Image>Encounters/1.png</Image>
      <TroopsToSpawn>
        <string>Antlion</string>
          <string>Antlion</string>
          <string>Antlion</string>
        <string>Antlion</string>
     </TroopsToSpawn>
    <ConfirmText>Clear them out</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>25</Chance>
      <TitleText>Operational</TitleText>
      <DescriptionText>The old mining equipment is ancient but in excellent shape. A few hours of work and it will be running for us.</DescriptionText>
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Nano Mine</ReplaceWith>
      <Image>Encounters/2.png</Image>
      <ConfirmText>Let's get to work</ConfirmText>
    </Outcome>

    <Outcome>
      <Chance>25</Chance>
      <TitleText>Salvage Operation</TitleText>
      <DescriptionText>Combat engineers go through the old mine and find the shafts too damaged to use. The recovered equipment will still sell very well on the open market.</DescriptionText>
      <MoneyGranted>750</MoneyGranted>      
      <RemoveTrigger>true</RemoveTrigger>
      <Image>Encounters/3.png</Image>
      <ConfirmText>Better than nothing</ConfirmText>
    </Outcome>
    <Outcome>
      <Chance>10</Chance>
      <TitleText>Salvage Operation</TitleText>
      <DescriptionText>While salvaging, the engineers find a strange artifact in the deepest part of the mine shaft.</DescriptionText>
      <GrantArtifact>true</GrantArtifact>      
      <RemoveTrigger>true</RemoveTrigger>
      <Image>Encounters/techevent1.png</Image>
      <ConfirmText>Call a transport</ConfirmText>
    </Outcome>
    <Outcome>
      <Chance>3</Chance>
      <TitleText>A Unique Technology</TitleText>
      <DescriptionText>A hidden cave leads to a vault where somebody hid an untested prototype. The cave is also visited by an automated fleet, which attacks at once.</DescriptionText>
      <UnlockTech>Ancient Ion Technology</UnlockTech>
      <ReplaceWith>Nano Mine</ReplaceWith>       
      <RemoveTrigger>true</RemoveTrigger>
      <RemnantShipsToSpawn>
          <string>Heavy Drone</string>
          <string>Xeno Fighter</string>
          <string>Xeno Fighter</string>
          <string>Xeno Fighter</string>
      </RemnantShipsToSpawn>       
      <TroopsToSpawn>
      </TroopsToSpawn>
      <Image>Encounters/techevent2.png</Image>       
      <ConfirmText>Use it quickly</ConfirmText>
    </Outcome>
    <Outcome>
      <Chance>4</Chance>
      <TitleText>A Unique Technology</TitleText>
      <DescriptionText>A hidden cave leads to a vault where somebody hid an untested prototype. Nausicaan raiders are lurking nearby, trying to take it for themselves.</DescriptionText>
      <UnlockTech>Ancient Repulsor</UnlockTech>       
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Nano Mine</ReplaceWith>
      <PirateShipsToSpawn>
          <string>Draug-Mk2</string>
          <string>Draug-Fighter-Mk2</string>
          <string>Draug-Fighter-Mk2</string>
          <string>Draug-Fighter-Mk2</string>
          <string>Draug-Fighter-Mk2</string>
          <string>Draug-Fighter-Mk2</string>
      </PirateShipsToSpawn>       
      <TroopsToSpawn>
      </TroopsToSpawn>
      <Image>Encounters/techevent1.png</Image>       
      <ConfirmText>Defend the find</ConfirmText>
    </Outcome>
    <Outcome>
      <Chance>10</Chance>
      <TitleText>Whoops</TitleText>
      <DescriptionText>The away team trips a decrepit security system as it explores the mine. A small Orion pirate flotilla, hiding on the planet, takes this personally.</DescriptionText> 
      <RemoveTrigger>true</RemoveTrigger>
      <ReplaceWith>Nano Mine</ReplaceWith>
      <PirateShipsToSpawn>
        <string>Corsair</string>
        <string>Corsair-Fighter</string>
          <string>Corsair-Fighter</string>
          <string>Corsair-Fighter</string>
          <string>Corsair-Fighter</string>
      </PirateShipsToSpawn>
      <Image>Encounters/pirates1.png</Image>
      <ConfirmText>Damn pirates</ConfirmText>
    </Outcome>

  </PotentialOutcomes>
 </ExplorationEvent>